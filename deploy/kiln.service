# systemd *user* unit: kiln needs no root, only /dev/kvm access.
#   install -Dm644 deploy/kiln.service ~/.config/systemd/user/kiln.service
#   systemctl --user daemon-reload && systemctl --user enable --now kiln
#   loginctl enable-linger $USER   # keep running while logged out
[Unit]
Description=kiln self-hosted CI (ephemeral QEMU/KVM runners)
# No After=network-online.target: that is a system unit, which a user unit cannot order
# against, so kiln may start before the network is up. ExecStartPre below waits for a default
# route (at most 30 s), and kiln itself copes with a network that is still not usable: GitHub
# calls, runner sweeps, the docker mirror and the filtered-egress probe are all retried with
# backoff, and for the first 3 minutes the dashboard and `kiln doctor` say "starting".

[Service]
# `-`: a box with no default route at all (offline LAN) still starts. $$ is systemd's escape for $.
ExecStartPre=-/bin/sh -c 'i=0; while [ $$i -lt 30 ]; do while read -r a b c; do [ "$$b" = 00000000 ] && exit 0; done < /proc/net/route; i=$$((i+1)); sleep 1; done'
TimeoutStartSec=60
ExecStart=%h/.local/bin/kiln serve
Restart=on-failure
RestartSec=5
# SIGTERM goes to kiln only. It stops launching, waits up to stop_grace_secs (config,
# default 25) for running jobs, then kills its VMs and deregisters their runners (leftovers
# are swept at the next start); after that the rest of the cgroup is SIGKILLed.
# A second SIGTERM to kiln alone (systemctl --user kill --kill-whom=main kiln) skips the wait.
# stop_grace_secs is capped at 570 to fit this timeout; kiln shortens it under a shorter one.
# A host shutdown or logout waits up to this long.
KillMode=mixed
TimeoutStopSec=600
# Job VMs run in their own transient scopes (kiln-vm-<id>.scope) so memory pressure kills one VM, not kiln;
# scopes outlive the service, so stopping it kills whatever is left of them.
ExecStopPost=-/usr/bin/systemctl --user kill --signal=SIGKILL 'kiln-vm-*.scope'
# io_uring rings count against the user's shared locked-memory limit. This only has an effect once the user
# manager's own limit is raised too; see Troubleshooting in docs/configuration.md. Above the manager's limit the
# unit still starts, with the limit clamped.
LimitMEMLOCK=infinity
# Files kiln and its VMs create (logs, overlays, sockets) are private to this user.
UMask=0077
# Optional: Environment=KILN_GITHUB_TOKEN=... (or set it from the dashboard)

[Install]
WantedBy=default.target
